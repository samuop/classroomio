# Required
DATABASE_URL=""
REDIS_URL=""
PUBLIC_SERVER_URL=""

TRUSTED_ORIGINS=""
BETTER_AUTH_SECRET=""

AUTH_BEARER_TOKEN=""
AUTH_COOKIE_DOMAIN=""

# Email provider — used by the API only for auth-flow emails (forgot
# password, password-reset confirmation, email verification, email-change
# verification). Every other email is sent by @cio/jobs-worker; see
# apps/jobs/.env.example. Both processes can point at the same SMTP server.
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_SENDER=""
SMTP_PASSWORD=""

# Optional Zoho ZeptoMail token. When set, @cio/email uses Zoho instead of
# nodemailer/SMTP. Same dual-process note as SMTP above.
# ZOHO_TOKEN=""

# Optional - MinIO (S3-compatible, for Docker / on-premise self-hosting)
# When API runs in Docker: use http://minio:9000. For local API: use http://localhost:9000
MINIO_ROOT_USER=""
MINIO_ROOT_PASSWORD=""
OBJECT_STORAGE_ENDPOINT=""
OBJECT_STORAGE_PUBLIC_ENDPOINT=""
OBJECT_STORAGE_ACCESS_KEY_ID=""
OBJECT_STORAGE_SECRET_ACCESS_KEY=""
OBJECT_STORAGE_FORCE_PATH_STYLE=""
OBJECT_STORAGE_MEDIA_PUBLIC_BASE_URL=""

# Optional - Cloudflare R2 (for hosted deployments)
# Solo se usan si NO estan las OBJECT_STORAGE_* de arriba: el almacenamiento
# elige S3/MinIO primero y cae a R2 solo si faltan las tres OBJECT_STORAGE_*.
CLOUDFLARE_BUCKET_ID=""
CLOUDFLARE_ACCESS_KEY=""
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_BUCKET_DOMAIN=""
CLOUDFLARE_SECRET_ACCESS_KEY=""

# Quien imprime los PDF y los PNG. Vacio o cualquier cosa = Chromium propio.
#
# El certificado se disena en HTML+CSS y hay que convertirlo a PDF; eso necesita
# un motor de navegador. Por defecto usamos el NUESTRO (Playwright), que viaja
# con el codigo: no pide credenciales, alcanza las imagenes que servimos
# nosotros —incluido localhost en desarrollo, donde Cloudflare siempre fallaba—
# y no manda los datos del alumno a un tercero.
#
# Poner "cloudflare" vuelve al motor remoto. Es la salida de emergencia si un
# dia el servidor no puede con el navegador; entonces SI hacen falta las dos
# variables de abajo.
CERTIFICATE_RENDERER=""

# Cloudflare Browser Rendering - solo con CERTIFICATE_RENDERER="cloudflare".
#
# Browser Rendering es el Chrome headless de Cloudflare: se le manda el HTML por
# REST y devuelve el archivo. Sin estas dos variables la descarga falla con un
# mensaje que las nombra (ver isRenderConfigured en src/utils/render.ts).
#
# ACCOUNT_ID es el mismo de arriba (panel de Cloudflare, cualquier zona).
# La key es un API Token propio con el permiso "Browser Rendering - Edit";
# NO es la Global API Key ni sirve el token de DNS.
#
# OJO: poner CLOUDFLARE_ACCOUNT_ID no cambia el almacenamiento a R2 mientras
# esten las OBJECT_STORAGE_*, porque R2 exige ademas ACCESS_KEY + SECRET.
CLOUDFLARE_RENDERING_API_KEY=""

# Sentry (server-side error tracking). Leave SENTRY_DSN unset to disable.
# Skipped automatically in dev (NODE_ENV !== 'production') and self-hosted (PUBLIC_IS_SELFHOSTED=true).
SENTRY_DSN=""
SENTRY_ENVIRONMENT="production"
SENTRY_TRACES_SAMPLE_RATE="0"

# BullMQ dashboard (/admin/queues) ───────────────────────────────────────────
# In dev the dashboard is open. In production it's hidden unless ONE of the
# following is set; failing requests get 404 (not 401) so the route stays
# invisible to scanners.
#
# Comma-separated allowlist of Better Auth user emails — log in normally,
# visit /admin/queues, the middleware checks your session.
# QUEUE_DASHBOARD_ADMIN_EMAILS="you@yourdomain.com,partner@yourdomain.com"
#
# Bearer-token escape hatch for curl / scripts. Pass via
# `Authorization: Bearer <token>` or `?token=<token>`.
# QUEUE_DASHBOARD_TOKEN=""

# Enterprise (Optional)
# Required only when using Enterprise-only features (SSO, token-auth, no-tracking)
LICENSE_KEY=""

# SSO (Optional)
# For enterprise SSO with SAML (future support)
# SSO_ENCRYPTION_KEY="your-32-character-secret-key"

# AI Assistant (Optional)
# Per-provider API keys. The dashboard model picker exposes Gemini 3 Flash
# (Google) and GPT-4o (OpenAI). Anthropic is supported in code but not in the
# picker UI. Set at least one key to enable the assistant.
OPENAI_API_KEY=""
GOOGLE_API_KEY=""
ANTHROPIC_API_KEY=""
MOONSHOT_API_KEY=""
MINIMAX_API_KEY=""
# Optional: override the Gemini model (default gemini-flash-lite-latest). E.g.
# gemini-flash-latest, gemini-3.6-flash. The *-latest aliases support caching.
# GOOGLE_MODEL=""
# Optional: the Gemini model that runs web research (search_web and the course
# wizard). Its own knob because grounding is a per-model capability — pointing
# GOOGLE_MODEL at a model without it would take research down with the chat.
# Unset, it follows GOOGLE_MODEL. Works whatever CHAT_PROVIDER is set to.
# GOOGLE_SEARCH_MODEL=""
# Gemini explicit context caching for uploaded documents (Capa 2b, teacher-only).
# When "true" and the provider is Google, a document >=16k chars (~4k tokens, the
# model minimum) is uploaded to a Gemini cachedContent once and referenced across
# turns at ~10% input cost instead of being re-sent every turn. TTL 15 min,
# renewed while in use (build/edit); dies minutes after the instructor stops.
# Cap: 400k tokens of material per course — beyond that the instructor is told
# to split into a separate course. Off by default; fully defensive (falls back
# to inline on any failure). Needs GOOGLE_API_KEY set.
# GEMINI_EXPLICIT_CACHE="false"
# Operational context budget (tokens) the assistant UI measures against for the
# context indicator and the "context full → compact" prompt. NOT the model's
# physical window (Gemini flash is 1M): a working ceiling so the UI nudges the
# teacher to compact before per-request cost climbs. Default 200000.
# AGENT_CONTEXT_BUDGET="200000"
# Optional: override the MiniMax model (default MiniMax-M2.7). E.g. MiniMax-M3, MiniMax-M2.7-highspeed
# MINIMAX_MODEL=""

# Extended thinking (Anthropic-compatible providers only — MiniMax supports
# `thinking` blocks on every model). Budget in tokens, billed as OUTPUT.
# Set either to 0 to turn thinking off for that phase without a deploy.
#
# Plan: judgement-heavy and only a few steps — how many sections, what depth,
# what the sources actually support. Worth a real budget.
# AGENT_THINKING_BUDGET_PLAN="4096"
#
# Build: mostly executing a plan already agreed, across up to 40 steps, so a
# large budget multiplies straight into the bill for little gain. Raise it if
# lesson content comes out shallow; drop it to 0 if tool calls get unreliable.
# AGENT_THINKING_BUDGET_BUILD="2048"

# Jina Reader — optional Bearer for higher rate limits when using fetch_documentation_url.
# READING pages only. FINDING them (search_web and the wizard's research) runs on
# Gemini's Grounding with Google Search and needs GOOGLE_API_KEY instead.
# JINA_API_KEY=""
# AGENT_MAX_FETCHES_PER_CONVERSATION=15
# AGENT_MAX_FETCHES_PER_ORG_PER_DAY=500

# Tinybird event tracking for AI observability (optional — silently skipped when not set)
# TINYBIRD_TOKEN=""
# TINYBIRD_BASE_URL="https://api.tinybird.co"