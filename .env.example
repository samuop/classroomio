# ClassroomIO Docker Self-Hosting Environment
# Copy this file to .env and fill in your values.
# For local development, the defaults work out of the box.
# For production, replace all placeholder values.

# ──────────────────────────────────────────────
# Required
# ──────────────────────────────────────────────

# Database (used by docker-compose to create the Postgres container)
POSTGRES_DB=classroomio
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Public URL where the API is reachable from browsers
# Local: http://localhost:3081 | Production: https://api.yourdomain.com
PUBLIC_SERVER_URL=http://localhost:3081

# Comma-separated origins allowed by CORS
# Local: http://localhost:3082 | Production: https://app.yourdomain.com
TRUSTED_ORIGINS=http://localhost:3082,http://localhost:5173

# Auth secret for session signing (use a long random string in production)
BETTER_AUTH_SECRET=replace-with-a-long-random-secret

# API bearer token (leave blank — auto-generated by ./run-docker-full-stack.sh)
AUTH_BEARER_TOKEN=

# Dashboard-to-API auth key (leave blank — auto-generated by ./run-docker-full-stack.sh)
# Must be the same value in both API and dashboard.
PRIVATE_SERVER_KEY=

# Self-hosted mode flag
PUBLIC_IS_SELFHOSTED=true

# Dashboard SSR calls to the API inside the Docker network
# Local: http://api:3081 | Production: http://api:3081 (always internal)
PRIVATE_SERVER_URL=http://api:3081

# Dashboard origin for SvelteKit CSRF protection and invite/email links
# Local: http://localhost:3082 | Production: https://app.yourdomain.com
# When set, invite emails and other links point here instead of app.classroomio.com
DASHBOARD_ORIGIN=http://localhost:3082

# CSP: external domains allowed by Content-Security-Policy.
# These are runtime env vars — set them when running the container (no rebuild needed).
# Comma-separated. Include your CDN, API, video, and font domains.
# ALLOWED_EXTERNAL_DOMAINS overrides all per-directive vars below.
ALLOWED_EXTERNAL_DOMAINS=
# Per-directive overrides (optional, comma-separated):
# CSP_SCRIPT_SRC_DOMAINS=
# CSP_STYLE_SRC_DOMAINS=
# CSP_CONNECT_SRC_DOMAINS=
# CSP_FRAME_SRC_DOMAINS=
# CSP_FONT_SRC_DOMAINS=
# CSP_MEDIA_SRC_DOMAINS=   (applies to both img-src and media-src)

# ──────────────────────────────────────────────
# Optional — Email (pick one approach, or skip)
# ──────────────────────────────────────────────

# Option A: Zoho / ZeptoMail
ZOHO_TOKEN=

# Option B: SMTP
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER=

# ──────────────────────────────────────────────
# Optional — Object Storage (auto-configured by ./run-docker-full-stack.sh)
# ──────────────────────────────────────────────

# MinIO is included by default. The startup script sets these automatically.
# Change credentials in production.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_ACCESS_KEY_ID=minioadmin
OBJECT_STORAGE_SECRET_ACCESS_KEY=minioadmin
OBJECT_STORAGE_FORCE_PATH_STYLE=true
OBJECT_STORAGE_MEDIA_PUBLIC_BASE_URL=http://localhost:9000/media

# Origin of the URL above, baked into the dashboard's CSP (img-src/media-src/
# connect-src) at build time. It MUST cover the host in
# OBJECT_STORAGE_MEDIA_PUBLIC_BASE_URL — the API writes absolute asset URLs into
# the DB, and if the origin is missing from the CSP the browser blocks every
# uploaded image (the card shows "Failed to load" while curl returns 200).
PUBLIC_MEDIA_HOST=http://localhost:9000

# ──────────────────────────────────────────────
# Optional — Integrations
# ──────────────────────────────────────────────

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Dashboard: Google Drive video picker (optional). Web OAuth client ID + browser API key; enable Picker API and Drive API on the same GCP project.
# PUBLIC_GOOGLE_PICKER_CLIENT_ID=
# PUBLIC_GOOGLE_PICKER_API_KEY=

# Cookie domain for auth. Set to your root domain (e.g. .yourdomain.com) when API and dashboard use different subdomains.
# Without this, auth cookies may not be set and login will fail.
AUTH_COOKIE_DOMAIN=

# Dashboard domain routing
PRIVATE_APP_HOST=localhost
PRIVATE_APP_SUBDOMAINS=app

# Unsplash image search
UNSPLASH_API_KEY=

# AI Assistant — set at least one provider key to enable the in-course chat.
#
# The CHAT provider is operator-controlled and limited to two options:
#   CHAT_PROVIDER=minimax  (default when unset)
#   CHAT_PROVIDER=google
# `pickAnyConfiguredProvider` falls back to the other one when the preferred
# key is missing, so a half-configured deploy keeps working on the other
# provider instead of silently disabling the agent. OPENAI/ANTHROPIC/MOONSHOT
# keys are NOT considered at chat time even when set.
CHAT_PROVIDER=minimax
MINIMAX_API_KEY=
# Optional override; defaults to MiniMax-M3.
MINIMAX_MODEL=

# GOOGLE_API_KEY is required even when CHAT_PROVIDER=minimax: embeddings (RAG
# over uploaded documents and lessons) always come from Google, because it is
# the only configured provider exposing an embedding endpoint. Without it,
# document indexing silently falls back to inlining the whole file into every
# turn — which measured 5x the context per request.
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
# Optional override; defaults to gemini-flash-lite-latest, an alias Google keeps
# pointed at the current stable Flash-Lite. Pin a version (e.g.
# gemini-3.5-flash-lite) when you want the cost and behaviour to stop moving
# under you. See knowledge/gemini-provider.md before switching CHAT_PROVIDER.
GOOGLE_MODEL=

# Enterprise license (SSO, token-auth, no-tracking)
LICENSE_KEY=

# Custom branding (meta tags)
# PUBLIC_APP_TITLE=My Learning Platform
# PUBLIC_APP_DESCRIPTION=A flexible LMS
# PUBLIC_OG_IMAGE_URL=https://app.yourdomain.com/og-image.png

# Language of the date printed on certificates. Defaults to es-AR, matching the
# Spanish-first defaults for the certificate wording. Set only if this
# deployment issues certificates in another language -- the date is formatted
# server-side both for the editor download and for real issuance, so there is no
# browser locale to fall back on.
# CERTIFICATE_DATE_LOCALE=es-AR
